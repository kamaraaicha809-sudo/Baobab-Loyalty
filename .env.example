# ============================================
# CONFIGURATION KODEFAST
# ============================================
# Copiez ce fichier vers .env.local et remplissez les valeurs
# cp .env.example .env.local

# ============================================
# MODE DEMO (optionnel)
# ============================================
# Mettre "true" pour tester l'interface sans configurer Supabase
# Idéal pour explorer le template avant le déploiement
NEXT_PUBLIC_DEMO_MODE=false

# ============================================
# SUPABASE (requis)
# ============================================
# Récupérez ces valeurs dans votre dashboard Supabase :
# Settings > API > Project URL et anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ============================================
# PRODUCTION (Vercel)
# ============================================
# URL de votre site en production (utilisé pour les redirections OAuth)
# Ne pas définir en développement local
# SITE_URL=https://votre-domaine.com
# NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ============================================
# SUPABASE SERVICE ROLE (pour API réservations et sondages)
# ============================================
# Requis pour créer des réservations depuis la page publique /offre
# et pour sauvegarder les sondages de satisfaction depuis /sondage
# Dashboard Supabase > Settings > API > service_role key (secret)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ============================================
# WHATSAPP (Meta Business)
# ============================================
# Obtenez votre App ID dans developers.facebook.com
# Requis pour le flow de connexion WhatsApp des hôteliers
# NEXT_PUBLIC_META_APP_ID=1234567890123456

# ============================================
# POSTHOG (analytics, optionnel)
# ============================================
# Récupérez ces valeurs dans app.posthog.com > Project Settings
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# NEXT_PUBLIC_POSTHOG_DEBUG=false

# ============================================
# AIRTABLE (formulaire de feedback, optionnel)
# ============================================
# Utilisé par app/api/feedback/route.ts
# AIRTABLE_API_KEY=patXXXXX

# ============================================
# SECRETS SUPABASE VAULT (ne pas mettre ici)
# ============================================
# Ces secrets sont configurés dans Supabase Dashboard > Settings > Vault
# NE PAS les mettre dans .env.local, ils sont gérés côté serveur
#
# MONEROO_API_KEY        - Clé API Moneroo pour les paiements FCFA
# MONEROO_WEBHOOK_SECRET - Secret de validation des webhooks Moneroo
# RESEND_API_KEY         - Clé API Resend pour les emails (re_...)
# OPENROUTER_API_KEY     - Clé OpenRouter pour l'IA (sk-or-...)
# EMAIL_FROM             - Adresse email d'envoi (noreply@votre-domaine.com)
# META_APP_ID            - App ID Meta côté serveur (whatsapp-connect)
# META_APP_SECRET        - Secret de l'app Meta pour WhatsApp OAuth
# UNIPILE_API_KEY        - Clé API Unipile pour LinkedIn → Template
# UNIPILE_DSN            - Nom de domaine du serveur Unipile (ex: api1.unipile.com)
# FNE_API_KEY            - Clé API par défaut pour la facturation électronique (FNE)
# FNE_WORKER_SECRET      - Secret d'appel du worker fne-worker
# SITE_URL               - URL du site en production (https://votre-domaine.com)
# DEMO_MODE              - "true" pour activer le mode démo côté Edge Functions
